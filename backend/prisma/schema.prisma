generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  repositories Repository[]
  chatSessions ChatSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Repository {
  id        String           @id @default(cuid())
  name      String
  githubUrl String
  branch    String           @default("main")
  status    RepositoryStatus @default(PENDING)
  localPath String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  files        File[]
  chatSessions ChatSession[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  indexingJobs IndexingJob[]

  @@index([userId])
}

model ChatSession {
  id String @id @default(cuid())

  userId       String
  repositoryId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  title String @default("New Repository Chat")

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([repositoryId])
}

model ChatMessage {
  id String @id @default(cuid())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    ChatMessageRole
  content String

  createdAt DateTime @default(now())

  @@index([sessionId])
}

model File {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  path      String
  name      String
  extension String?
  language  String?
  size      Int
  content   String

  chunks Chunk[]

  outgoingDependencies Dependency[] @relation("SourceFile")
  incomingDependencies Dependency[] @relation("TargetFile")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
}

model Dependency {
  id String @id @default(cuid())

  sourceFileId String
  targetFileId String

  sourceFile File @relation("SourceFile", fields: [sourceFileId], references: [id], onDelete: Cascade)
  targetFile File @relation("TargetFile", fields: [targetFileId], references: [id], onDelete: Cascade)

  type String

  createdAt DateTime @default(now())

  @@unique([sourceFileId, targetFileId, type])
  @@index([sourceFileId])
  @@index([targetFileId])
}

model Chunk {
  id String @id @default(cuid())

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  content String

  chunkIndex Int
  startLine  Int
  endLine    Int

  embeddingId String?
  embeddedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([fileId])
}

enum RepositoryStatus {
  PENDING
  CLONING
  SCANNING
  CHUNKING
  EMBEDDING
  READY
  FAILED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum IndexingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum IndexingStep {
  CLONING
  SCANNING
  CHUNKING
  DEPENDENCY_ANALYSIS
  EMBEDDING
  INDEXING
}

model IndexingJob {
  id           String @id @default(cuid())
  repositoryId String

  status      IndexingJobStatus @default(QUEUED)
  progress    Int               @default(0)
  currentStep IndexingStep?

  error String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([status])
  @@index([createdAt])
}
